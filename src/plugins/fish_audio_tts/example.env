# Fish Audio TTS Plugin Environment Variables Example
# 复制此文件到项目根目录并重命名为 .env，然后填入实际的值

# Fish Audio API配置
# 从 https://fish.audio/go-api/ 获取API密钥
FISH_AUDIO_API_KEY=sk-your-api-key-here

# Fish Audio模型ID
# 在Fish Audio平台创建或选择语音模型后获取
FISH_AUDIO_MODEL_ID=your-model-id-here

# 代理配置（可选）
# 如果在中国大陆使用，可能需要配置代理
# 常见的代理配置：
# Clash: http://127.0.0.1:7890
# V2Ray: http://127.0.0.1:10809
# Shadowsocks: socks5://127.0.0.1:1080
FISH_AUDIO_PROXY_URL=http://127.0.0.1:7890 